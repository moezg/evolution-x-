# Copy to .env. Secrets are read by the API process only; simulated agents and sandboxed
# code-evolution workers never receive them (sandbox env is scrubbed).
EVOX_LLM=mock                 # mock (offline, default) | anthropic | openai
EVOX_LLM_MODEL=               # e.g. claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
